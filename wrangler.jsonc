{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "car-dealer-crm",
	"compatibility_date": "2026-11-10",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	// No public deploy yet: no workers.dev URL and no routes.
	"workers_dev": false,
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "car-dealer-crm"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			// Placeholder: the real id comes from `wrangler hyperdrive create` (task 9).
			// Create it with caching disabled.
			"id": "00000000000000000000000000000000",
			"localConnectionString": "postgresql://crm_app:dev@localhost:54328/crm_dev"
		}
	],
	"ratelimits": [
		{
			"name": "LOGIN_RATE_LIMITER",
			// Unique integer (as a string) per rate limiter in the account.
			"namespace_id": "1001",
			"simple": { "limit": 5, "period": 60 }
		}
	]
}
