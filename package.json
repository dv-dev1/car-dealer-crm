{
  "name": "car-dealer-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --import ./scripts/load-dev-vars.mjs node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "db:migrate": "node db/migrate.ts",
    "db:dev": "node db/local-cluster.ts",
    "db:app-login": "node scripts/create-app-login.ts",
    "store:create": "node scripts/create-store.ts",
    "demo:store": "node scripts/demo-store.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "check:secrets": "node scripts/check-bundle-secrets.mjs"
  },
  "dependencies": {
    "@workos-inc/authkit-nextjs": "4.6.3",
    "@workos-inc/node": "12.2.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.25.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@opennextjs/cloudflare": "1.20.16",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0",
    "wrangler": "4.160.0"
  }
}
